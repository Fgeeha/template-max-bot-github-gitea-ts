{
  "name": "max-bot-template",
  "version": "0.1.0",
  "description": "Шаблон чат-бота для мессенджера MAX (GitHub + Gitea CI/CD, TypeScript)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "bin": {
    "bot": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate up",
    "migration": "node-pg-migrate create",
    "init-project": "tsx scripts/init-project.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
