{
  "name": "max-bot-template",
  "version": "0.1.0",
  "description": "Шаблон чат-бота для мессенджера MAX (GitHub + Gitea CI/CD, TypeScript)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "bin": {
    "bot": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate up",
    "migration": "node-pg-migrate create",
    "init-project": "tsx scripts/init-project.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
